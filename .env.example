# ==================== APLICACIÓN ====================
PROJECT_NAME=BandangWeb API
VERSION=1.0.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# ==================== BASE DE DATOS ====================
DATABASE_URL=postgresql+asyncpg://bandang_user:bandang_password@localhost:5432/bandangweb_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ==================== SEGURIDAD ====================
# IMPORTANTE: Este SECRET_KEY es un ejemplo generado criptográficamente.
# En producción, DEBES generar uno ÚNICO y NUNCA compartirlo públicamente.
# Para generar uno nuevo ejecuta: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Requisitos: Mínimo 32 caracteres, máxima entropía, nunca reutilizar entre ambientes.
SECRET_KEY=Uz7gboitssJQvzMLp5jVWtYK6n021az--9q9QVW2jXVP_wRsj-H9xizWxa3i-8VdtnhywiciuqIdU0oliHxh7w
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# ==================== CORS ====================
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==================== RATE LIMITING ====================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==================== CELERY ====================
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=db+sqlite:///celery-results.sqlite

# ==================== EMAIL (Opcional) ====================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ==================== AWS S3 (Opcional) ====================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================== SUPABASE ====================
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_REALTIME_ENABLED=true
